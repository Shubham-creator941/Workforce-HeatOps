generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model SystemRecord {
  id        String   @id @default(uuid()) @db.Char(36)
  key       String   @unique @db.VarChar(128)
  value     String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
